# Prisma / Postgres
# Use Supabase Transaction pooler for runtime/serverless traffic.
DATABASE_URL="postgresql://postgres.mffeaorisqkvhsckzuns:replace-with-password@replace-with-pooler-host:6543/postgres"

# Use Supabase Direct connection for migrations and schema operations.
DIRECT_URL="postgresql://postgres:replace-with-password@db.mffeaorisqkvhsckzuns.supabase.co:5432/postgres"

# Sign-in (src/lib/auth.ts)
# The access code every session signs in with.
APP_ACCESS_CODE=
# The owner's email, the one account the sign-in admits.
APP_ACCESS_USER_EMAIL=
# Signs the session cookie; falls back to the access code when unset.
APP_AUTH_COOKIE_SECRET=

# Claude (src/lib/claude/health.ts)
# The model key; unset, every reader falls back to its rule-based half.
ANTHROPIC_API_KEY=
# Sent as the anthropic-workspace-id header on every call when set.
ANTHROPIC_WORKSPACE_ID=

# The GitHub vault (src/app/room/archive-actions.ts)
# owner/repo the dropped files archive to.
GITHUB_ARCHIVE_REPO=
# A token that can write to that repo; never rendered, logged, or bundled.
GITHUB_ARCHIVE_TOKEN=

# Salesforce (src/lib/salesforce.ts)
# The org's Lightning domain for record links; defaults to prismhr.lightning.force.com.
NEXT_PUBLIC_SF_BASE_URL=
